# rustrouter environment variables, all optional. Copy to `.env` and edit.
#
# rustrouter reads these from the process environment. It does NOT load `.env`
# itself: export them in your shell, or pass them through your service manager.
# See docs/RUNTIME.md and docs/DB-PARITY.md for the behaviour of each.

# Where the SQLite database, model catalog and backups live.
# Default: %APPDATA%/9router on Windows, ~/.9router elsewhere.
# DATA_DIR=

# Bind address. `-p/--port` and `-H/--host` flags win over these.
# Defaults: PORT=20129, HOSTNAME=0.0.0.0
# PORT=20129
# HOSTNAME=0.0.0.0

# Bootstrap dashboard password, used only while no password hash is stored.
# The built-in default (123456) is refused to non-loopback clients, so a
# container reached through a published port needs this set. Once you change
# the password in the UI, the stored hash wins and this is ignored.
# INITIAL_PASSWORD=

# HMAC key for session tokens. When unset, a random 32-byte key is generated
# once into <DATA_DIR>/jwt-secret. Set it to keep sessions valid across hosts.
# JWT_SECRET=

# Salt for the derived machine id. Changing it changes every API key prefix.
# MACHINE_ID_SALT=

# Secret behind the API key checksum. Rotating it invalidates every issued key.
# API_KEY_SECRET=

# Force the session cookie's `Secure` flag on even over plain HTTP, for a
# deployment behind a TLS terminator. Set to exactly `true` to enable.
# AUTH_COOKIE_SECURE=true

# Base URL for the CommandCode usage/limits API. Default: the provider's own.
# COMMAND_CODE_API_BASE_URL=

# Debug toggles surfaced in the settings payload. `true` enables each.
# ENABLE_REQUEST_LOGS=false
# ENABLE_TRANSLATOR=false

# Set to `off` to disable the periodic model-catalog sync. Unset means enabled.
# MODEL_CATALOG_SYNC=off

# `true` logs a periodic RSS/memory report from the server. Debug aid.
# RUSTROUTER_MEM_REPORT=false

# rustrouter environment variables, all optional. Copy to `.env` and edit.
#
# rustrouter reads these from the process environment. It does NOT load `.env`
# itself: export them in your shell, or pass them through your service manager.
# See docs/RUNTIME.md and docs/DB-PARITY.md for the behaviour of each.

# Where the SQLite database, model catalog and backups live.
# Default: %APPDATA%/9router on Windows, ~/.9router elsewhere.
# DATA_DIR=

# Bind address. `-p/--port` and `-H/--host` flags win over these.
# Defaults: PORT=20129, HOSTNAME=0.0.0.0
# PORT=20129
# HOSTNAME=0.0.0.0

# HMAC key for session tokens. When unset, a random 32-byte key is generated
# once into <DATA_DIR>/jwt-secret. Set it to keep sessions valid across hosts.
# JWT_SECRET=

# Salt for the derived machine id. Changing it changes every API key prefix.
# MACHINE_ID_SALT=

# Secret behind the API key checksum. Rotating it invalidates every issued key.
# API_KEY_SECRET=

# Base URL of a local Headroom proxy. Default: http://localhost:8787
# HEADROOM_URL=
